# ================================================================
# UMKMetrics — Environment Configuration (Supabase)
# ================================================================
# Salin file ini dan isi nilainya sesuai environment kamu.
# JANGAN commit file .env yang sudah berisi nilai asli ke Git!
# ================================================================

# ── Database (Supabase / PostgreSQL) ────────────────────────────
# Supabase Dashboard > Connect > Connection string (tab "PHP"/"URI")
# Pilih salah satu:
#  • Direct          : db.<project-ref>.supabase.co        port 5432  user postgres
#  • Session pooler  : aws-0-<region>.pooler.supabase.com  port 5432  user postgres.<project-ref>  (untuk hosting IPv4-only)
#  • Transaction pool: aws-0-<region>.pooler.supabase.com  port 6543  user postgres.<project-ref>
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_SUPABASE_DB_PASSWORD_HERE
DB_SSLMODE=require
DB_TIMEZONE=Asia/Jakarta

# ── App Settings ─────────────────────────────────────────────────
# production | development
APP_ENV=production
APP_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────
# URL frontend kamu (tanpa trailing slash)
CORS_ORIGIN=http://umkmnexa.infinityfreeapp.com

# ── JWT Authentication ───────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman (min. 32 karakter)
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_KEY_HERE
# Durasi token dalam detik (default: 28800 = 8 jam)
JWT_EXPIRE=28800

# ── Pagination ───────────────────────────────────────────────────
PAGE_LIMIT_DEFAULT=15
PAGE_LIMIT_MAX=100
